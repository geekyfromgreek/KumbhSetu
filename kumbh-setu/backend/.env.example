# Kumbh Setu — Environment Variables
# Copy this to .env and fill in your keys

# Supabase (leave empty for demo mode with SQLite)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# AI APIs (optional — translation will fall back to static strings)
GEMINI_API_KEY=
GROQ_API_KEY=

# Google Maps (optional — deep-linking works without a key)
GOOGLE_MAPS_API_KEY=

# Pricing thresholds
PRICE_FLAG_THRESHOLD_PERCENT=30.0
RICKSHAW_BASE_FARE=25.0
RICKSHAW_PER_KM=15.0

# DeepFace (optional — falls back to mock embeddings)
DEEPFACE_MODEL=Facenet512
FACE_MATCH_THRESHOLD=0.68

# Dataset path (relative to backend/app/)
DATASET_CSV_PATH=../../data/nashik-all.csv
