{
  "name": "kumbhsetu-admins",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "build:web": "expo export -p web",
    "electron:start": "electron electron-main.js",
    "electron:dev": "npm run build:web && electron electron-main.js",
    "electron:dist": "npm run build:web && electron-builder --win",
    "electron:pack": "npm run build:web && electron-builder --dir",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.115.0",
    "expo": "~57.0.20",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.3",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.3"
  },
  "build": {
    "appId": "com.gauruu.kumbhsetuadmins",
    "productName": "KumbhSetu Admins",
    "extraMetadata": {
      "main": "electron-main.js"
    },
    "asar": true,
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron-main.js",
      "dist/**/*",
      "assets/**/*",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/images/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KumbhSetu Admins"
    },
    "nodeGypRebuild": false,
    "npmRebuild": false
  },
  "private": true,
  "description": "This is an [Expo](https://expo.dev) project created with [`create-expo-app`](https://www.npmjs.com/package/create-expo-app).",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
